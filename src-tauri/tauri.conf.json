{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Branchly",
  "version": "0.1.0",
  "identifier": "app.branchly.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Branchly",
        "width": 1380,
        "height": 880,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "dragDropEnabled": false,
        "backgroundColor": "#071821"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "capabilities": ["main-window"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Cliente Git ligero y moderno",
    "longDescription": "Branchly es un cliente Git de escritorio ligero, con gráfica de commits, staging por hunk, ramas, stash y más.",
    "icon": [
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["git"],
        "desktopTemplate": "linux/branchly.desktop",
        "section": "vcs"
      },
      "rpm": {
        "depends": ["git"],
        "desktopTemplate": "linux/branchly.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
